<!DOCTYPE html>
<html>
<head>
    <title>WebRTC Remote Camera</title>
    <script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
    <style>
        body { font-family: sans-serif; text-align: center; background: #222; color: white; }
        video { width: 80%; max-width: 600px; border: 2px solid #007bff; border-radius: 10px; margin-top: 20px; }
        .controls { margin: 20px; padding: 20px; border: 1px solid #444; }
        button { padding: 10px 20px; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 5px; }
    </style>
</head>
<body>
    <h1>Acces Cameră la Distanță</h1>
    
    <div class="controls">
        <p>ID-ul tău actual: <strong id="my-id">Se încarcă...</strong></p>
        <input type="text" id="remote-id" placeholder="Introdu ID-ul laptopului">
        <button onclick="connectToPeer()">Conectare la Cameră</button>
    </div>

    <video id="remote-video" autoplay playsinline></video>

    <script>
        const peer = new Peer(); // Creează un ID unic automat
        let localStream;

        // Afișăm ID-ul generat pentru acest dispozitiv
        peer.on('open', (id) => {
            document.getElementById('my-id').innerText = id;
        });

        // 1. Logica pentru LAPTOP (Transmițător)
        // Așteptăm să fim "sunați" de alt dispozitiv
        peer.on('call', (call) => {
            navigator.mediaDevices.getUserMedia({ video: true, audio: false })
                .then((stream) => {
                    call.answer(stream); // Trimitem fluxul video
                    console.log("Transmitem video...");
                });
        });

        // 2. Logica pentru RECEPTOR (Telefon/Alt PC)
        function connectToPeer() {
            const remoteId = document.getElementById('remote-id').value;
            // Cerem o conexiune (fără să trimitem video de la noi)
            const call = peer.call(remoteId, null); 
            
            call.on('stream', (remoteStream) => {
                // Afișăm video-ul primit de la laptop
                const video = document.getElementById('remote-video');
                video.srcObject = remoteStream;
            });
        }
    </script>
</body>
</html>
